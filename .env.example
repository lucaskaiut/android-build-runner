# Docker Compose environment.
# Copy to .env and adjust. All values have safe defaults for local development.

# Ports published on the host (Windows sees these as http://localhost:<port>)
NGINX_PORT=8100
WEB_PORT=5174

# MySQL (internal service name is "mysql"; DB_* values are used by the API container)
DB_ROOT_PASSWORD=root
DB_DATABASE=build_platform
DB_USERNAME=platform
DB_PASSWORD=secret
# Loopback-only port for optional host tools (HeidiSQL, mysql client)
DB_FORWARD_PORT=3307

# Web container mode: "dev" (Vite dev server, hot reload) or "preview" (production build)
WEB_MODE=dev
CHOKIDAR_USEPOLLING=false
