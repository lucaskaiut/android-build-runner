APP_NAME="Local Build Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8100
APP_TIMEZONE=UTC

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_LEVEL=debug

# MySQL is mandatory. Inside Docker the service name is "mysql".
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=build_platform
DB_USERNAME=platform
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true when serving the panel over HTTPS (Cloudflare Tunnel).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Origins allowed to authenticate with session cookies (the panel).
SANCTUM_STATEFUL_DOMAINS=localhost:5174,127.0.0.1:5174,localhost:8100,127.0.0.1:8100

# Comma separated proxies trusted for X-Forwarded-* headers.
TRUSTED_PROXIES=*

MAIL_MAILER=log

# ---------------------------------------------------------------------------
# Build platform tuning
# ---------------------------------------------------------------------------
BUILD_LEASE_SECONDS=180
RUNNER_OFFLINE_SECONDS=120
BUILD_LOG_MAX_LINES=100000
BUILD_LOG_MAX_MESSAGE_BYTES=8192
BUILD_LOG_MAX_BATCH_EVENTS=500
BUILD_LOG_RETENTION_DAYS=90
BUILD_ARTIFACT_MAX_MB=512
BUILD_ARTIFACT_RETENTION_DAYS=30
BUILD_DEFAULT_TIMEOUT=3600
BUILD_MAX_TIMEOUT=21600
BUILD_RECORD_RETENTION_DAYS=180
